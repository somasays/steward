  "additionalProperties": false,
  "description": "`GET /v1/assets/{id}`: the asset and the columns discovered on it,\nin the source's own ordinal order.",
  "properties": {
    "asset": {
      "$ref": "#/$defs/Asset"
    },
    "columns": {
